# Example unit for infra-agent. Copy it to /etc/systemd/system/infra-agent.service, then:
#   systemctl daemon-reload && systemctl enable --now infra-agent
# The settings are in /etc/infra-agent/agent.env (docs/agent.md); the agent reads that file itself.
[Unit]
Description=infra-agent (fetch, verify and apply the config bundle, report)
Documentation=https://github.com/KazuhaHub/infra-hub/blob/main/docs/agent.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
ExecStart=/usr/local/bin/infra-agent run
Restart=always
RestartSec=30
# Stopping sends SIGTERM; a running ansible-playbook is asked to stop, and is killed after 30 s.
TimeoutStopSec=60
KillMode=mixed

# Hardening. ansible has to be able to change anything on the host (packages, /etc, services, users, kernel settings,
# mounts), so the unit must not take away what a configuration run needs:
#   - no ProtectSystem, ProtectHome, PrivateTmp, ReadWritePaths or other file system sandboxing: it would make
#     ansible's writes fail or, worse, land in a private copy of the file system;
#   - no User=: root is required;
#   - no capability bounding, no RestrictAddressFamilies, no SystemCallFilter: tasks may need any of them;
#   - NoNewPrivileges=no on purpose: tasks run sudo/su and setuid helpers (and some roles install setuid
#     files); NoNewPrivileges=yes would break them.
# What is safe to restrict is the agent's own exposure:
NoNewPrivileges=no
# The agent opens no listening port. UMask is left alone on purpose: ansible tasks inherit it, and a changed umask would
# change the modes of files that tasks create without an explicit mode.
# Logs go to the journal (stderr); nothing writes log files.
StandardOutput=journal
StandardError=journal
SyslogIdentifier=infra-agent
# Ansible needs a HOME and a PATH that find ansible-playbook, git and sops.
Environment=HOME=/root
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
# Low priority: the agent must not slow the machine's real work down.
Nice=10

[Install]
WantedBy=multi-user.target
